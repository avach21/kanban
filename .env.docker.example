# Copy to `.env.docker` and run:
# docker compose --env-file .env.docker up --build
#
# Plain `docker compose up --build` also works because docker-compose.yml
# includes matching defaults for local development.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kanban

# Keep the host as `db` unless you rename the database service.
DATABASE_URL=postgres://postgres:postgres@db:5432/kanban

API_PORT=3001
WEB_PORT=5173

# If you change API_PORT or WEB_PORT, update the two URLs below to match.
# This must match the browser origin that serves the web container.
CORS_ORIGIN=http://localhost:5173

# Vite bakes this into the web image at build time, so rebuild `web` after changes.
VITE_API_URL=http://localhost:3001
BETTER_AUTH_URL=http://localhost:3001

BETTER_AUTH_SECRET=replace_with_a_long_random_string_at_least_32_chars
DOG_API_BASE_URL=https://api.thedogapi.com/v1
DB_MIGRATE_MAX_ATTEMPTS=20
