# Paste these into Dokploy's Environment Variables for the Docker Compose service.
# Dokploy writes them to a `.env` file beside `docker-compose.yml`, and this repo
# consumes them via `${VAR}` interpolation in `docker-compose.yml`.
# Recommended Dokploy setup for this app:
# - web domain: https://m11k.org -> service `web` on container port `80`
# - api domain: https://api.m11k.org -> service `api` on container port `3001`
# Point Dokploy at `docker-compose.dokploy.yml` instead of the local compose file.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=kanban

# Keep the host as `db` unless you rename the database service in docker-compose.yml.
# The password inside DATABASE_URL must match POSTGRES_PASSWORD exactly.
# If your password includes special URL characters like @ : / ? # %, URL-encode it.
DATABASE_URL=postgres://postgres:replace_with_a_strong_database_password@db:5432/kanban

NODE_ENV=production

# `VITE_API_URL` is baked into the web image at build time, so Dokploy must rebuild
# the deployment after you change it.
CORS_ORIGIN=https://m11k.org
VITE_API_URL=https://api.m11k.org
BETTER_AUTH_URL=https://api.m11k.org

# Generate a long random value with a password manager or:
# openssl rand -base64 48
BETTER_AUTH_SECRET=replace_with_a_long_random_string_at_least_32_chars
DOG_API_BASE_URL=https://api.thedogapi.com/v1
DB_MIGRATE_MAX_ATTEMPTS=60
